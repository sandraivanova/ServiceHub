# Copy this file to .env and fill in real values before running
# `docker compose up`. .env itself is gitignored — never commit real
# secrets.
#
# DB_HOST and REDIS_HOST are set to the Docker Compose service names
# (see docker-compose.yml) so the backend container can reach them over
# the Docker network. Leave them as-is unless you change the service
# names.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=changeme-root
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=servicehub
DB_USERNAME=servicehub
DB_PASSWORD=changeme-db

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis

# ---- Backend ----
PORT=3000
# Used by different files in the codebase for the same purpose (legacy
# naming inconsistency) - set all four so the app works no matter which
# one a given file reads.
JWT_SECRET=changeme-jwt-secret
JWT_ACCESS_SECRET=changeme-jwt-access-secret
JWT_REFRESH_SECRET=changeme-jwt-refresh-secret
REFRESH_SECRET=changeme-jwt-refresh-secret
# bcrypt salt rounds used to hash passwords - required, the app refuses
# to start without it.
HASH_SALT=10
# Outgoing mail (password reset / welcome / confirmation emails). Safe
# to leave as placeholders for local demo purposes - email sending will
# just fail silently in the background job.
NODEMAILER_SERVICE=gmail
NODEMAILER_AUTH_USER=example@gmail.com
NODEMAILER_AUTH_PASS=changeme-app-password
